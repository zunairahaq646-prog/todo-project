
<h1>Edit Todo</h1>

<%= form_with model: @todo do |form| %>
  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :description %>
    <%= form.text_area :description %>
  </div>

  <div>
    <%= form.label :status %>
    <%= form.select :status, ["pending", "completed", "cancelled"] %>
  </div>

  <%= form.submit "Update Todo" %>
<% end %>

<%= link_to "Back to Todos", todos_path %>

