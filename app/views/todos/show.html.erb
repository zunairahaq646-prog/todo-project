
<div class="min-h-screen bg-purple-50 px-4 py-12">
  <div class="mx-auto max-w-2xl">

    <div class="mb-6">
      <%= link_to "← Back to Todo List", todos_path,
          class: "text-sm font-semibold text-purple-600 transition hover:text-purple-900" %>
    </div>

    <div class="rounded-3xl border border-purple-100 bg-white p-8 shadow-lg">

      <div class="mb-6 flex items-center justify-between gap-4">
        <% if @todo.status == "completed" %>
          <span class="rounded-full bg-purple-100 px-4 py-2 text-sm font-bold text-purple-700">
            Completed
          </span>
        <% elsif @todo.status == "cancelled" %>
          <span class="rounded-full bg-fuchsia-100 px-4 py-2 text-sm font-bold text-fuchsia-700">
            Cancelled
          </span>
        <% else %>
          <span class="rounded-full bg-violet-100 px-4 py-2 text-sm font-bold text-violet-700">
            Pending
          </span>
        <% end %>
      </div>

      <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-purple-500">
        Todo Details
      </p>

      <h1 class="mb-5 text-3xl font-bold text-purple-950">
        <%= @todo.title %>
      </h1>

      <div class="mb-6 rounded-2xl bg-purple-50 p-5">
        <h2 class="mb-2 text-sm font-bold text-purple-800">Description</h2>
        <p class="whitespace-pre-wrap leading-7 text-gray-600">
          <%= @todo.description.presence || "No description added." %>
        </p>
      </div>

      <div class="mb-8 border-t border-purple-100 pt-5">
        <p class="text-sm text-gray-500">Current Status</p>
        <p class="mt-1 font-bold capitalize text-purple-800">
          <%= @todo.status %>
        </p>
      </div>

      <div class="flex flex-wrap gap-3">
        <%= link_to "✏️ Edit Todo", edit_todo_path(@todo),
            class: "rounded-xl bg-gradient-to-r from-violet-700 to-purple-500 px-6 py-3 font-bold text-white shadow-md transition hover:-translate-y-0.5 hover:shadow-lg" %>

        <%= button_to "🗑 Delete Todo", todo_path(@todo),
            method: :delete,
            data: { turbo_confirm: "Are you sure you want to delete this todo?" },
            class: "cursor-pointer rounded-xl border border-fuchsia-200 bg-fuchsia-50 px-6 py-3 font-bold text-fuchsia-700 transition hover:bg-fuchsia-100" %>
      </div>

    </div>
  </div>
</div>
