
<div class="todo-dashboard">
  <div class="mx-auto max-w-6xl">

  
    <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="mt-1 text-3xl font-bold text-slate-800">Dashboard</h1>
        <p class="mt-2 text-slate-500">Organize tasks</p>
      </div>

      <%= link_to new_todo_path,
          class: "rounded-xl bg-violet-600 px-5 py-3 font-semibold text-white shadow-md hover:bg-violet-700" do %>
        + Add New Task
      <% end %>
    </div>
    <div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">

      <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
        <p class="text-sm text-slate-500">Total Tasks</p>
        <h2 class="mt-2 text-3xl font-bold text-slate-800">
          <%= @pending_todos.count + @completed_todos.count + @cancelled_todos.count %>
        </h2>
        <p class="mt-1 text-xs text-slate-400">All your tasks</p>
      </div>

      <div class="rounded-2xl border border-amber-100 bg-amber-50 p-5">
        <p class="text-sm text-amber-700">Pending</p>
        <h2 class="mt-2 text-3xl font-bold text-amber-800"><%= @pending_todos.count %></h2>
        <p class="mt-1 text-xs text-amber-600">Waiting to be done</p>
      </div>

      <div class="rounded-2xl border border-emerald-100 bg-emerald-50 p-5">
        <p class="text-sm text-emerald-700">Completed</p>
        <h2 class="mt-2 text-3xl font-bold text-emerald-800"><%= @completed_todos.count %></h2>
        <p class="mt-1 text-xs text-emerald-600">Successfully finished</p>
      </div>

      <div class="rounded-2xl border border-rose-100 bg-rose-50 p-5">
        <p class="text-sm text-rose-700">Cancelled</p>
        <h2 class="mt-2 text-3xl font-bold text-rose-800"><%= @cancelled_todos.count %></h2>
        <p class="mt-1 text-xs text-rose-600">Cancelled tasks</p>
      </div>

    </div>
    <section class="mb-8">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-xl font-bold text-slate-800">Pending Tasks</h2>
        <span class="rounded-full bg-amber-100 px-3 py-1 text-sm font-semibold text-amber-700">
          <%= @pending_todos.count %> Tasks
        </span>
      </div>

      <% if @pending_todos.any? %>
        <div class="grid gap-4 md:grid-cols-2">
          <% @pending_todos.each do |todo| %>
            <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
              <div class="mb-3 flex items-start justify-between gap-3">
                <h3 class="text-lg font-bold text-slate-800"><%= todo.title %></h3>
                <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-700">Pending</span>
              </div>

              <p class="mb-5 text-sm text-slate-500"><%= todo.description %></p>

              <div class="flex flex-wrap items-center gap-3 border-t border-slate-100 pt-4 text-sm">
                <%= link_to "View", todo_path(todo), class: "font-semibold text-violet-600 hover:text-violet-800" %>
                <%= link_to "Edit", edit_todo_path(todo), class: "font-semibold text-slate-600 hover:text-slate-900" %>

                <%= button_to "Complete", todo_path(todo),
                    method: :patch,
                    params: { todo: { status: "completed" } },
                    class: "rounded-lg bg-emerald-100 px-3 py-2 font-semibold text-emerald-700 hover:bg-emerald-200" %>

                <%= button_to "Cancel", todo_path(todo),
                    method: :patch,
                    params: { todo: { status: "cancelled" } },
                    class: "rounded-lg bg-rose-100 px-3 py-2 font-semibold text-rose-700 hover:bg-rose-200" %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-500">
          No pending tasks. Add a new task to get started!
        </div>
      <% end %>
    </section>
    <section class="mb-8">
      <h2 class="mb-4 text-xl font-bold text-slate-800">Completed Tasks</h2>

      <% if @completed_todos.any? %>
        <div class="grid gap-4 md:grid-cols-2">
          <% @completed_todos.each do |todo| %>
            <div class="rounded-2xl border border-emerald-100 bg-white p-5 shadow-sm">
              <div class="mb-2 flex items-center justify-between gap-3">
                <h3 class="font-bold text-slate-800"><%= todo.title %></h3>
                <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-700">Completed</span>
              </div>
              <p class="mb-3 text-sm text-slate-500"><%= todo.description %></p>
              <%= link_to "View Details", todo_path(todo), class: "text-sm font-semibold text-violet-600" %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-6 text-center text-slate-500">
          No completed tasks yet.
        </div>
      <% end %>
    </section>
    <section>
      <h2 class="mb-4 text-xl font-bold text-slate-800">Cancelled Tasks</h2>

      <% if @cancelled_todos.any? %>
        <div class="grid gap-4 md:grid-cols-2">
          <% @cancelled_todos.each do |todo| %>
            <div class="rounded-2xl border border-rose-100 bg-white p-5 shadow-sm">
              <div class="mb-2 flex items-center justify-between gap-3">
                <h3 class="font-bold text-slate-800"><%= todo.title %></h3>
                <span class="rounded-full bg-rose-100 px-3 py-1 text-xs font-semibold text-rose-700">Cancelled</span>
              </div>
              <p class="mb-3 text-sm text-slate-500"><%= todo.description %></p>
              <%= link_to "View Details", todo_path(todo), class: "text-sm font-semibold text-violet-600" %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-6 text-center text-slate-500">
          No cancelled tasks.
        </div>
      <% end %>
    </section>
  </div>
</div>


