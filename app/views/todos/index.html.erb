
<div class="todo-dashboard">
  <div class="mx-auto max-w-6xl">
    <div class="mb-8 rounded-3xl bg-gradient-to-r from-violet-700 to-purple-500 p-8 text-white shadow-lg">
      <div class="flex flex-wrap items-center justify-between gap-5">
        <div>
          <h1 class="text-3xl font-bold">Dashboard</h1>
          <p class="mt-2 text-sm text-purple-100">
            Keep your tasks organized.
          </p>
        </div>
        <%= link_to new_todo_path,
            class: "rounded-xl bg-white px-5 py-3 font-bold text-purple-700 shadow-md transition hover:bg-purple-100" do %>
          + Add New Task
        <% end %>
      </div>
    </div>
    <div class="mb-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-2xl border border-purple-100 bg-white p-5 shadow-sm">
        <p class="text-sm font-medium text-purple-500">Total Tasks</p>
        <h2 class="mt-3 text-3xl font-bold text-purple-900">
          <%= @pending_todos.count + @completed_todos.count + @cancelled_todos.count %>
        </h2>
        <p class="mt-2 text-xs text-purple-400">All your tasks</p>
      </div>

      <div class="rounded-2xl border border-violet-100 bg-violet-50 p-5">
        <p class="text-sm font-medium text-violet-600">Pending</p>
        <h2 class="mt-3 text-3xl font-bold text-violet-800">
          <%= @pending_todos.count %>
        </h2>
        <p class="mt-2 text-xs text-violet-500">Waiting to be done</p>
      </div>

      <div class="rounded-2xl border border-purple-100 bg-purple-50 p-5">
        <p class="text-sm font-medium text-purple-600">Completed</p>
        <h2 class="mt-3 text-3xl font-bold text-purple-800">
          <%= @completed_todos.count %>
        </h2>
        <p class="mt-2 text-xs text-purple-500">Successfully finished</p>
      </div>

      <div class="rounded-2xl border border-fuchsia-100 bg-fuchsia-50 p-5">
        <p class="text-sm font-medium text-fuchsia-600">Cancelled</p>
        <h2 class="mt-3 text-3xl font-bold text-fuchsia-800">
          <%= @cancelled_todos.count %>
        </h2>
        <p class="mt-2 text-xs text-fuchsia-500">Cancelled tasks</p>
      </div>
    </div>
    <section class="mb-10">
      <div class="mb-5 flex items-center justify-between">
        <h2 class="text-xl font-bold text-purple-950">Pending Tasks</h2>
        <span class="rounded-full bg-violet-100 px-4 py-2 text-sm font-semibold text-violet-700">
          <%= @pending_todos.count %> Tasks
        </span>
      </div>

      <% if @pending_todos.any? %>
        <div class="grid gap-5 md:grid-cols-2">
          <% @pending_todos.each do |todo| %>
            <div class="rounded-2xl border border-purple-100 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
              <div class="mb-4 flex justify-between gap-3">
                <h3 class="text-lg font-bold text-purple-950"><%= todo.title %></h3>
                <span class="rounded-full bg-violet-100 px-3 py-1 text-xs font-bold text-violet-700">
                  Pending
                </span>
              </div>

              <p class="mb-5 text-sm leading-6 text-gray-500">
                <%= todo.description %>
              </p>

              <div class="flex flex-wrap items-center gap-3 border-t border-purple-100 pt-4 text-sm">
                <%= link_to "View", todo_path(todo),
                    class: "font-semibold text-purple-600 hover:text-purple-900" %>

                <%= link_to "Edit", edit_todo_path(todo),
                    class: "font-semibold text-gray-600 hover:text-purple-700" %>
                <%= button_to "Complete", todo_path(todo),
                    method: :patch,
                    params: { todo: { status: "completed" } },
                    class: "rounded-lg bg-purple-100 px-3 py-2 font-semibold text-purple-700 transition hover:bg-purple-200" %>
                <%= button_to "Cancel", todo_path(todo),
                    method: :patch,
                    params: { todo: { status: "cancelled" } },
                    class: "rounded-lg bg-fuchsia-50 px-3 py-2 font-semibold text-fuchsia-700 transition hover:bg-fuchsia-100" %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="rounded-2xl border border-dashed border-purple-200 bg-white p-8 text-center text-purple-500">
          No pending tasks. Add a new task to get started!
        </div>
      <% end %>
    </section>
    <section class="mb-10">
      <div class="mb-5 flex items-center justify-between">
        <h2 class="text-xl font-bold text-purple-950">Completed Tasks</h2>
        <span class="rounded-full bg-purple-100 px-4 py-2 text-sm font-semibold text-purple-700">
          <%= @completed_todos.count %> Tasks
        </span>
      </div>

      <% if @completed_todos.any? %>
        <div class="grid gap-5 md:grid-cols-2">
          <% @completed_todos.each do |todo| %>
            <div class="rounded-2xl border border-purple-100 bg-white p-6 shadow-sm">
              <div class="mb-3 flex items-center justify-between gap-3">
                <h3 class="font-bold text-purple-950"><%= todo.title %></h3>
                <span class="rounded-full bg-purple-100 px-3 py-1 text-xs font-bold text-purple-700">
                  Completed
                </span>
              </div>
              <p class="mb-4 text-sm leading-6 text-gray-500"><%= todo.description %></p>
              <%= link_to "View Details", todo_path(todo),
                  class: "text-sm font-semibold text-purple-600 hover:text-purple-900" %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="rounded-2xl border border-dashed border-purple-200 bg-white p-7 text-center text-purple-500">
          No completed tasks yet.
        </div>
      <% end %>
    </section>
    <section class="mb-8">
      <div class="mb-5 flex items-center justify-between">
        <h2 class="text-xl font-bold text-purple-950">Cancelled Tasks</h2>
        <span class="rounded-full bg-fuchsia-100 px-4 py-2 text-sm font-semibold text-fuchsia-700">
          <%= @cancelled_todos.count %> Tasks
        </span>
      </div>
      <% if @cancelled_todos.any? %>
        <div class="grid gap-5 md:grid-cols-2">
          <% @cancelled_todos.each do |todo| %>
            <div class="rounded-2xl border border-fuchsia-100 bg-white p-6 shadow-sm">
              <div class="mb-3 flex items-center justify-between gap-3">
                <h3 class="font-bold text-purple-950"><%= todo.title %></h3>
                <span class="rounded-full bg-fuchsia-100 px-3 py-1 text-xs font-bold text-fuchsia-700">
                  Cancelled
                </span>
              </div>
              <p class="mb-4 text-sm leading-6 text-gray-500"><%= todo.description %></p>
              <%= link_to "View Details", todo_path(todo),
                  class: "text-sm font-semibold text-purple-600 hover:text-purple-900" %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="rounded-2xl border border-dashed border-purple-200 bg-white p-7 text-center text-purple-500">
          No cancelled tasks.
        </div>
      <% end %>
    </section>
  </div>
</div>

